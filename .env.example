# ---------------------------------------------------------------------------
# Alumnium AI provider.
# This demo runs FULLY OFFLINE using a local Ollama model (no API keys).
# The exact same tests run against any hosted provider by changing ALUMNIUM_MODEL
# (openai / anthropic / google / github / xai ...) — that provider-swap is the point.
# ---------------------------------------------------------------------------
ALUMNIUM_MODEL=ollama

# Where Ollama is served.
#   - local run (Ollama on your machine):     http://localhost:11434
#   - docker-compose (ollama service):        http://ollama:11434   (set in compose)
ALUMNIUM_OLLAMA_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Selenium.
#   - empty / unset  -> use a local Chrome (headed, great for a live demo)
#   - a URL          -> use a remote Selenium (the dockerized standalone-chromium)
# ---------------------------------------------------------------------------
SELENIUM_URL=

# System under test
BASE_URL=https://www.saucedemo.com
