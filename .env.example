# ---------------------------------------------------------------------------
# Alumnium AI provider.
# This demo runs FULLY OFFLINE using a local Ollama model (no API keys).
# The exact same tests run against any hosted provider by changing ALUMNIUM_MODEL
# (openai / anthropic / google / github / xai ...) — that provider-swap is the point.
# ---------------------------------------------------------------------------
ALUMNIUM_MODEL=ollama

# Where Ollama is served. Leave empty for a local run — Alumnium finds Ollama
# on your machine automatically. Only set this when Ollama runs elsewhere
# (e.g. docker-compose's "ollama" service, set to http://ollama.internal:11434
# there). Note: Alumnium's validator requires a dotted hostname, so a bare
# single-label host like "localhost" or the Compose service name "ollama" is
# rejected — that's why docker-compose.yml gives the ollama service the extra
# "ollama.internal" network alias instead of using its plain service name.
ALUMNIUM_OLLAMA_URL=

# ---------------------------------------------------------------------------
# Selenium.
#   - empty / unset  -> use a local Chrome (headed, great for a live demo)
#   - a URL          -> use a remote Selenium (the dockerized standalone-chromium)
# ---------------------------------------------------------------------------
SELENIUM_URL=

# System under test
BASE_URL=https://www.saucedemo.com
